@*
    Reusable confirm dialog. Usage:

      <MudDialog @bind-Visible="_open">
          <DialogContent>...</DialogContent>
      </MudDialog>

    OR programmatic via IDialogService:

      var result = await DialogService.ShowAsync<ConfirmDialog>("Delete?",
          new DialogParameters
          {
              ["Message"] = "This cannot be undone.",
              ["ConfirmText"] = "Delete",
              ["ConfirmColor"] = Color.Error,
          });
      if ((bool?)(await result.Result)?.Data == true) { ... }
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@CancelText</MudButton>
        <MudButton Color="@ConfirmColor" Variant="Variant.Filled" OnClick="Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance? MudDialog { get; set; }

    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    [Parameter] public string CancelText { get; set; } = "Cancel";
    [Parameter] public Color ConfirmColor { get; set; } = Color.Primary;

    private void Cancel() => MudDialog?.Cancel();
    private void Confirm() => MudDialog?.Close(DialogResult.Ok(true));
}
