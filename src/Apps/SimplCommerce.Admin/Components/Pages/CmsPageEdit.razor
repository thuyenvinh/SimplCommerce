@page "/cms/pages/create"
@page "/cms/pages/edit/{Id:long}"
@rendermode RenderMode.InteractiveServer
@inject IAdminCmsApi Cms
@inject NavigationManager Nav
@inject ISnackbar Snack

<PageTitle>@(Id is null ? "New CMS page" : $"Edit CMS page #{Id}")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/cms/pages"))" aria-label="Back" />
    <MudText Typo="Typo.h4">@(Id is null ? "New CMS page" : $"Edit CMS page #{Id}")</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <EditForm Model="_form" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <MudPaper Class="pa-4 mb-4">
            <MudTextField @bind-Value="_form.Name" Label="Name" Required="true" />
            <MudTextField @bind-Value="_form.Slug" Label="Slug" Required="true" HelperText="URL-friendly identifier; e.g. about-us." />
            <MudSwitch @bind-Value="_form.IsPublished" Label="Published" Color="Color.Primary" />
        </MudPaper>
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Body</MudText>
            <MudTextField @bind-Value="_form.Body" Label="Body (HTML or plain text)" Lines="18" />
        </MudPaper>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving">@(_saving ? "Saving…" : "Save")</MudButton>
        <MudButton OnClick="@(() => Nav.NavigateTo("/cms/pages"))" Class="ml-2">Cancel</MudButton>
    </EditForm>
}

@code {
    [Parameter] public long? Id { get; set; }

    private FormModel _form = new();
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } id)
        {
            var dto = await Cms.GetPageAsync(id);
            if (dto is null)
            {
                Snack.Add("Page not found.", Severity.Error);
                Nav.NavigateTo("/cms/pages");
                return;
            }
            _form = new FormModel { Name = dto.Name, Slug = dto.Slug, Body = dto.Body, IsPublished = dto.IsPublished };
        }
        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var input = new AdminCmsPageInput(_form.Name, _form.Slug, _form.Body, _form.IsPublished);
            using var resp = Id is { } id
                ? await Cms.UpdatePageAsync(id, input)
                : await Cms.CreatePageAsync(input);
            if (!resp.IsSuccessStatusCode)
            {
                Snack.Add($"Save failed (HTTP {(int)resp.StatusCode}).", Severity.Error);
                return;
            }
            Snack.Add(Id is null ? "Page created." : "Page saved.", Severity.Success);
            Nav.NavigateTo("/cms/pages");
        }
        finally
        {
            _saving = false;
        }
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string? Body { get; set; }
        public bool IsPublished { get; set; } = true;
    }
}
