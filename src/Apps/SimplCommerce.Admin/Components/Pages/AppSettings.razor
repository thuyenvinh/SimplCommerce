@page "/settings"
@rendermode RenderMode.InteractiveServer
@inject IAdminCoreApi Core
@inject ISnackbar Snack

<PageTitle>App settings — Admin</PageTitle>
<MudText Typo="Typo.h4" Class="mb-4">App settings</MudText>

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.End" Class="mb-3">
        <MudTextField @bind-Value="_moduleFilter" Label="Filter by module (optional)" Style="max-width:280px" />
        <MudButton OnClick="Reload" Variant="Variant.Outlined">Apply</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _newOpen = true)">Add</MudButton>
    </MudStack>

    @if (_newOpen)
    {
        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
            <MudStack Row="true">
                <MudTextField @bind-Value="_newKey" Label="Key (Id)" Required="true" />
                <MudTextField @bind-Value="_newValue" Label="Value" Required="true" />
                <MudButton OnClick="AddNew" Color="Color.Primary">Save</MudButton>
                <MudButton OnClick="@(() => _newOpen = false)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_rows is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_rows.Count == 0)
    {
        <MudAlert Severity="Severity.Info">No settings.</MudAlert>
    }
    else
    {
        <MudTable T="EditRow" Items="_editRows" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Key</MudTh><MudTh>Module</MudTh><MudTh>Value</MudTh><MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@(context.Module ?? "—")</MudTd>
                <MudTd>
                    <MudTextField @bind-Value="context.Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudTd>
                <MudTd>
                    <MudButton OnClick="@(() => Save(context))" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">Save</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private IReadOnlyList<AdminAppSettingItem>? _rows;
    private List<EditRow> _editRows = new();
    private string _moduleFilter = string.Empty;
    private bool _newOpen;
    private string _newKey = string.Empty;
    private string _newValue = string.Empty;

    protected override async Task OnInitializedAsync() => await Reload();

    private async Task Reload()
    {
        _rows = await Core.ListAppSettingsAsync(string.IsNullOrWhiteSpace(_moduleFilter) ? null : _moduleFilter);
        _editRows = _rows?.Select(r => new EditRow { Id = r.Id, Value = r.Value, Module = r.Module }).ToList() ?? new();
        StateHasChanged();
    }

    private async Task Save(EditRow row)
    {
        using var resp = await Core.UpsertAppSettingAsync(row.Id, new AdminAppSettingInput(row.Value));
        if (resp.IsSuccessStatusCode) { Snack.Add($"Saved {row.Id}.", Severity.Success); }
        else { Snack.Add($"Save failed (HTTP {(int)resp.StatusCode}).", Severity.Error); }
    }

    private async Task AddNew()
    {
        if (string.IsNullOrWhiteSpace(_newKey)) { Snack.Add("Key is required.", Severity.Warning); return; }
        using var resp = await Core.UpsertAppSettingAsync(_newKey, new AdminAppSettingInput(_newValue));
        if (resp.IsSuccessStatusCode)
        {
            Snack.Add("Setting added.", Severity.Success);
            _newOpen = false; _newKey = ""; _newValue = "";
            await Reload();
        }
        else { Snack.Add($"Add failed (HTTP {(int)resp.StatusCode}).", Severity.Error); }
    }

    private class EditRow
    {
        public string Id { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
        public string? Module { get; set; }
    }
}
