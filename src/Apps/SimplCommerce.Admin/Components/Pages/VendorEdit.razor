@page "/vendors/create"
@page "/vendors/edit/{Id:long}"
@rendermode RenderMode.InteractiveServer
@inject IAdminVendorsApi Vendors
@inject NavigationManager Nav
@inject ISnackbar Snack

<PageTitle>@(Id is null ? "New vendor" : $"Edit vendor #{Id}")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/vendors"))" aria-label="Back" />
    <MudText Typo="Typo.h4">@(Id is null ? "New vendor" : $"Edit vendor #{Id}")</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <EditForm Model="_form" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <MudPaper Class="pa-4 mb-4">
            <MudTextField @bind-Value="_form.Name" Label="Name" Required="true" />
            <MudTextField @bind-Value="_form.Slug" Label="Slug" Required="true" />
            <MudTextField @bind-Value="_form.Email" Label="Email" />
            <MudTextField @bind-Value="_form.Description" Label="Description" Lines="4" />
            <MudSwitch @bind-Value="_form.IsActive" Label="Active" Color="Color.Primary" />
        </MudPaper>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="_saving">@(_saving ? "Saving…" : "Save")</MudButton>
        <MudButton OnClick="@(() => Nav.NavigateTo("/vendors"))" Class="ml-2">Cancel</MudButton>
    </EditForm>
}

@code {
    [Parameter] public long? Id { get; set; }

    private FormModel _form = new();
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (Id is { } id)
        {
            var dto = await Vendors.GetAsync(id);
            if (dto is null)
            {
                Snack.Add("Vendor not found.", Severity.Error);
                Nav.NavigateTo("/vendors");
                return;
            }
            _form = new FormModel
            {
                Name = dto.Name, Slug = dto.Slug, Description = dto.Description,
                Email = dto.Email, IsActive = dto.IsActive,
            };
        }
        _loading = false;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var input = new AdminVendorInput(_form.Name, _form.Slug, _form.Description, _form.Email, _form.IsActive);
            using var resp = Id is { } id
                ? await Vendors.UpdateAsync(id, input)
                : await Vendors.CreateAsync(input);
            if (!resp.IsSuccessStatusCode)
            {
                Snack.Add($"Save failed (HTTP {(int)resp.StatusCode}).", Severity.Error);
                return;
            }
            Snack.Add(Id is null ? "Vendor created." : "Vendor saved.", Severity.Success);
            Nav.NavigateTo("/vendors");
        }
        finally
        {
            _saving = false;
        }
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? Email { get; set; }
        public bool IsActive { get; set; } = true;
    }
}
