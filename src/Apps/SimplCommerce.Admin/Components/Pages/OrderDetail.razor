@page "/orders/{Id:long}"
@rendermode RenderMode.InteractiveServer
@inject IAdminOrdersApi Orders
@inject IAdminShipmentsApi Shipments
@inject IAdminInventoryApi Inventory
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Order #@Id — SimplCommerce admin</PageTitle>

@if (_order is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/orders"))" aria-label="Back to orders" />
        <MudText Typo="Typo.h4">Order #@_order.Id</MudText>
        <MudChip T="string" Color="@StatusColor(_order.OrderStatus)" Size="Size.Small">@StatusLabel(_order.OrderStatus)</MudChip>
        <MudSpacer />
        <MudSelect T="int" Label="Update status" Value="_targetStatus" ValueChanged="OnStatusChanged" Dense="true" Variant="Variant.Outlined" Style="min-width:200px;">
            @foreach (var s in StatusOptions)
            {
                <MudSelectItem T="int" Value="@s.Value">@s.Label</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo"
                   Disabled="@(_order.OrderStatus == 90)" OnClick="MarkRefunded">Refund</MudButton>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">Items</MudText>
                <MudTable Items="_order.Items" Dense="true" Striped="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>Product</MudTh>
                        <MudTh>Qty</MudTh>
                        <MudTh>Unit price</MudTh>
                        <MudTh>Discount</MudTh>
                        <MudTh>Line total</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Product">@context.ProductName</MudTd>
                        <MudTd DataLabel="Qty">@context.Quantity</MudTd>
                        <MudTd DataLabel="Unit price">@context.ProductPrice.ToString("C")</MudTd>
                        <MudTd DataLabel="Discount">@context.DiscountAmount.ToString("C")</MudTd>
                        <MudTd DataLabel="Line total">@((context.ProductPrice * context.Quantity - context.DiscountAmount).ToString("C"))</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4 mb-3">
                <MudText Typo="Typo.h6">Totals</MudText>
                <MudText><strong>Subtotal:</strong> @_order.SubTotal.ToString("C")</MudText>
                <MudText><strong>Discount:</strong> @_order.DiscountAmount.ToString("C")</MudText>
                <MudText><strong>Tax:</strong> @_order.TaxAmount.ToString("C")</MudText>
                <MudText><strong>Shipping:</strong> @_order.ShippingAmount.ToString("C")</MudText>
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.h6"><strong>Total:</strong> @_order.OrderTotal.ToString("C")</MudText>
            </MudPaper>
            <MudPaper Class="pa-4 mb-3">
                <MudText Typo="Typo.h6">Customer</MudText>
                <MudText>@_order.CustomerFullName</MudText>
                <MudText Typo="Typo.body2">@_order.CustomerEmail</MudText>
                <MudText Typo="Typo.caption">Created @_order.CreatedOn.LocalDateTime</MudText>
            </MudPaper>
            @if (_order.ShippingAddress is { } ship)
            {
                <MudPaper Class="pa-4 mb-3">
                    <MudText Typo="Typo.h6">Shipping to</MudText>
                    <MudText>@ship.ContactName</MudText>
                    <MudText Typo="Typo.body2">@ship.Phone</MudText>
                    <MudText Typo="Typo.body2">@ship.AddressLine1</MudText>
                    @if (!string.IsNullOrWhiteSpace(ship.AddressLine2))
                    {
                        <MudText Typo="Typo.body2">@ship.AddressLine2</MudText>
                    }
                    <MudText Typo="Typo.body2">@ship.City @ship.ZipCode</MudText>
                </MudPaper>
            }
            @if (!string.IsNullOrWhiteSpace(_order.PaymentMethod))
            {
                <MudPaper Class="pa-4">
                    <MudText Typo="Typo.h6">Payment</MudText>
                    <MudText>@_order.PaymentMethod</MudText>
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">Shipments</MudText>
                    <MudSpacer />
                    <MudButton StartIcon="@Icons.Material.Filled.LocalShipping" Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="@(() => _shipDialog = true)" Disabled="@(_warehouses is null || _warehouses.Count == 0)">
                        New shipment
                    </MudButton>
                </MudStack>

                @if (_shipments is null)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_shipments.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No shipments yet for this order.</MudAlert>
                }
                else
                {
                    <MudTable T="AdminShipmentListItem" Items="_shipments" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>ID</MudTh><MudTh>Tracking #</MudTh><MudTh>Warehouse</MudTh>
                            <MudTh>Lines</MudTh><MudTh>Created</MudTh><MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Id</MudTd>
                            <MudTd>@context.TrackingNumber</MudTd>
                            <MudTd>@WarehouseName(context.WarehouseId)</MudTd>
                            <MudTd>@context.ItemCount</MudTd>
                            <MudTd>@context.CreatedOn.LocalDateTime.ToString("g")</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteShipment(context.Id))" aria-label="Delete" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudDialog @bind-Visible="_shipDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
        <TitleContent>New shipment for order #@_order.Id</TitleContent>
        <DialogContent>
            <MudSelect T="long" @bind-Value="_newShip.WarehouseId" Label="Warehouse" Required="true">
                @if (_warehouses is not null)
                {
                    @foreach (var w in _warehouses) { <MudSelectItem T="long" Value="@w.Id">@w.Name</MudSelectItem> }
                }
            </MudSelect>
            <MudTextField @bind-Value="_newShip.TrackingNumber" Label="Tracking number (optional)" Class="mt-3" />
            <MudText Typo="Typo.subtitle2" Class="mt-3 mb-2">Items to ship</MudText>
            @foreach (var line in _newShipLines)
            {
                <MudStack Row="true" Class="mb-1" AlignItems="AlignItems.Center">
                    <MudCheckBox T="bool" @bind-Value="line.Include" />
                    <MudText Style="flex:1">@line.ProductName <MudText Typo="Typo.caption">(ordered: @line.MaxQty)</MudText></MudText>
                    <MudNumericField T="int" @bind-Value="line.Qty" Min="1" Max="@line.MaxQty" Disabled="@(!line.Include)" Style="width:120px" />
                </MudStack>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _shipDialog = false)">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateShipment" Disabled="_creatingShip">
                @(_creatingShip ? "Saving…" : "Create shipment")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter] public long Id { get; set; }

    private AdminOrderDetail? _order;
    private int _targetStatus;

    private IReadOnlyList<AdminShipmentListItem>? _shipments;
    private IReadOnlyList<AdminWarehouseItem>? _warehouses;
    private bool _shipDialog;
    private bool _creatingShip;
    private NewShipForm _newShip = new();
    private List<NewShipLine> _newShipLines = new();

    private string WarehouseName(long id) => _warehouses?.FirstOrDefault(w => w.Id == id)?.Name ?? id.ToString();

    private static readonly (int Value, string Label)[] StatusOptions =
    {
        (1,   "New"),
        (10,  "On hold"),
        (20,  "Pending payment"),
        (30,  "Payment received"),
        (35,  "Payment failed"),
        (40,  "Invoiced"),
        (50,  "Shipping"),
        (60,  "Shipped"),
        (70,  "Complete"),
        (80,  "Canceled"),
        (90,  "Refunded"),
        (100, "Closed"),
    };

    protected override async Task OnInitializedAsync()
    {
        _order = await Orders.GetAsync(Id);
        if (_order is null)
        {
            Snackbar.Add("Order not found.", Severity.Error);
            Nav.NavigateTo("/orders");
            return;
        }
        _targetStatus = _order.OrderStatus;
        _warehouses = await Inventory.ListWarehousesAsync();
        if (_warehouses is { Count: > 0 }) _newShip.WarehouseId = _warehouses[0].Id;
        await ReloadShipments();
        RebuildShipLines();
    }

    private async Task ReloadShipments()
    {
        _shipments = await Shipments.ListAsync(orderId: Id);
        StateHasChanged();
    }

    private void RebuildShipLines()
    {
        if (_order is null) return;
        _newShipLines = _order.Items.Select(i => new NewShipLine
        {
            OrderItemId = 0,
            ProductId = i.ProductId,
            ProductName = i.ProductName,
            MaxQty = i.Quantity,
            Qty = i.Quantity,
            Include = true,
        }).ToList();
    }

    private async Task CreateShipment()
    {
        if (_order is null) return;
        _creatingShip = true;
        try
        {
            var lines = _newShipLines.Where(l => l.Include && l.Qty > 0)
                .Select(l => new AdminShipmentItemInput(l.OrderItemId, l.ProductId, l.Qty))
                .ToList();
            if (lines.Count == 0)
            {
                Snackbar.Add("Pick at least one item.", Severity.Warning);
                return;
            }
            using var resp = await Shipments.CreateAsync(new AdminShipmentInput(
                Id, _newShip.WarehouseId, _newShip.TrackingNumber, lines));
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Create failed (HTTP {(int)resp.StatusCode}).", Severity.Error);
                return;
            }
            Snackbar.Add("Shipment created.", Severity.Success);
            _shipDialog = false;
            await ReloadShipments();
        }
        finally
        {
            _creatingShip = false;
        }
    }

    private async Task DeleteShipment(long id)
    {
        using var resp = await Shipments.DeleteAsync(id);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Shipment removed.", Severity.Success);
            await ReloadShipments();
        }
        else { Snackbar.Add($"Delete failed (HTTP {(int)resp.StatusCode}).", Severity.Error); }
    }

    private async Task MarkRefunded()
    {
        await OnStatusChanged(90);
    }

    private class NewShipForm
    {
        public long WarehouseId { get; set; }
        public string? TrackingNumber { get; set; }
    }

    private class NewShipLine
    {
        public long OrderItemId { get; set; }
        public long ProductId { get; set; }
        public string ProductName { get; set; } = string.Empty;
        public int MaxQty { get; set; }
        public int Qty { get; set; }
        public bool Include { get; set; }
    }

    private async Task OnStatusChanged(int next)
    {
        if (_order is null || next == _order.OrderStatus) return;
        _targetStatus = next;
        using var resp = await Orders.UpdateStatusAsync(Id, new UpdateOrderStatusRequest(next));
        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add($"Update failed (HTTP {(int)resp.StatusCode}).", Severity.Error);
            return;
        }
        _order = await Orders.GetAsync(Id);
        Snackbar.Add("Status updated.", Severity.Success);
    }

    private static Color StatusColor(int status) => status switch
    {
        1 or 10 => Color.Info,
        20 => Color.Warning,
        30 or 40 or 50 or 60 => Color.Primary,
        70 => Color.Success,
        80 or 90 or 100 => Color.Default,
        35 => Color.Error,
        _ => Color.Default,
    };

    private static string StatusLabel(int status)
        => StatusOptions.FirstOrDefault(s => s.Value == status).Label ?? status.ToString();
}
