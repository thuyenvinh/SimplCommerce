@page "/cart"
@attribute [Authorize]
@rendermode RenderMode.InteractiveServer
@inject ICartApi CartClient
@inject ICheckoutApi CheckoutClient
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Your cart — SimplCommerce</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Your cart</MudText>

@if (_raw is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <pre>@_raw</pre>
    </MudPaper>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               OnClick="StartCheckout" Disabled="_starting">
        @(_starting ? "Starting checkout…" : "Proceed to checkout")
    </MudButton>
}

@code {
    private string? _raw;
    private bool _starting;

    protected override async Task OnInitializedAsync()
    {
        var resp = await CartClient.GetAsync();
        _raw = resp.IsSuccessStatusCode
            ? await resp.Content.ReadAsStringAsync()
            : $"Cart unavailable (HTTP {(int)resp.StatusCode}).";
    }

    private async Task StartCheckout()
    {
        _starting = true;
        try
        {
            var resp = await CheckoutClient.StartAsync();
            if (resp is null)
            {
                Snackbar.Add("Could not start checkout. Make sure your cart isn't empty.", Severity.Warning);
                return;
            }
            Nav.NavigateTo($"/checkout/{resp.CheckoutId}/address");
        }
        finally
        {
            _starting = false;
        }
    }
}
